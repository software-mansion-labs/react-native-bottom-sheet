{
  "expo": {
    "name": "React Native Bottom Sheet Example",
    "slug": "react-native-bottom-sheet-example",
    "version": "1.1.0-next.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swmansion.reactnativebottomsheet.example",
      "infoPlist": {
        "CFBundleDisplayName": "React Native Bottom Sheet"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.swmansion.reactnativebottomsheet.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["./plugins/withAndroidAppName", "React Native Bottom Sheet"],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
