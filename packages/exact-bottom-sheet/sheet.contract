// The bottom sheet as a Contract component: `use BottomSheet, SheetConfig,
// sheetConfig from "@swmansion/exact-bottom-sheet/sheet"`. It is the
// counterpart of `src/BottomSheet.tsx`'s content wrapper: the caller's
// children go inside a content node the component lays out at the sheet's
// content region (the widest card's width, the region's height, from the
// tag's built-in `change` event), followed by a zero-height content-height
// marker (`${id}-end`), whose top the adapters read as the `content` detent's
// height. So `flex: 1` children fill the region and a scrolling child scrolls
// within it, with no binding in the app. See README.md ("Using the view").
//
// The interface's shapes (exact.json), declared again: a package's Contract
// file is resolved where it really is, where no `node_modules` holds this
// package, and `use` takes only `.contract` files, so this file can't `use`
// them. Shapes are nominal in Contract, so an app that uses the component
// takes these (`use SheetDetent, … from "@swmansion/exact-bottom-sheet/sheet"`);
// the tag checks them field by field against its declared props, so the raw
// tag takes them too.
shape SheetInsets
  left: number
  right: number
  bottom: number

shape SheetDetent
  value: string
  programmatic: option<bool>
  insets: option<SheetInsets>
  scrimOpacity: option<number>

shape SheetShadow
  offsetX: number
  offsetY: number
  blurRadius: number
  spreadDistance: number
  color: string
  opacity: number

shape SheetPosition
  position: number
  index: number

shape SheetRegion
  width: number
  height: number

// The tag's optional props, each as the tag takes it (`none` is unset).
shape SheetConfig
  topInset: option<number>
  modal: option<bool>
  animateIn: option<bool>
  animateContentHeight: option<bool>
  settleDuration: option<number>
  scrollExpand: option<enum<"none", "initial", "handoff">>
  scrollCollapse: option<enum<"none", "initial", "handoff">>
  scrimColor: option<string>
  scrimLabel: option<string>
  // Any CSS colour, Exact's roles (`-exact-secondary-grouped-background`) and
  // `light-dark()` included: the component draws the surface as a Contract
  // node, so it follows dark mode as the rest of the app does.
  surfaceColor: option<string>
  // A CSS `background-image` for the surface (a gradient, `url(…)`), drawn
  // over `surfaceColor`: the component's counterpart of a `surface` element.
  surfaceBackgroundImage: option<string>
  surfaceCornerRadii: option<number[]>
  surfaceCornerCurve: option<enum<"circular", "continuous">>
  surfaceShadows: option<SheetShadow[]>
  handlesCloseRequest: option<bool>
  // The component's own option, as `lazy` on `BottomSheet.tsx`: the content is
  // in the tree only while the sheet is open or still closing. It mounts in the
  // same update that `index` selects an open detent, and unmounts once the
  // sheet settles at a closed detent, so it stays visible throughout the
  // closing animation. The tag itself stays mounted (React Native unmounts its
  // native view too): it is what reports the sheet coming to rest, and on the
  // web a new tag attaches only after the next paint, too late to report a
  // close that starts right after an open. At rest it raises no events. No
  // effect when no detent is closed.
  lazy: option<bool>
  // The component's own option, as `nativeOverlay` on `ModalBottomSheet`: a
  // modal sheet is lifted into Exact's top layer, above everything, native
  // modal routes included, and sized to the window wherever it is mounted
  // (a popover, which iOS lifts above route sheets and the web puts in the
  // browser's top layer). The sheet opened last is in front. No effect on an
  // inline sheet.
  nativeOverlay: option<bool>

// Every option unset: the tag's defaults. Change fields with copy-with:
// `SheetConfig(sheetConfig(), modal=some(true))`.
fn sheetConfig(): SheetConfig = SheetConfig(topInset=none, modal=none, animateIn=none, animateContentHeight=none, settleDuration=none, scrollExpand=none, scrollCollapse=none, scrimColor=none, scrimLabel=none, surfaceColor=none, surfaceBackgroundImage=none, surfaceCornerRadii=none, surfaceCornerCurve=none, surfaceShadows=none, handlesCloseRequest=none, lazy=none, nativeOverlay=none)

// One number of the `change` event's "<width>,<height>,<resting closed>,
// <surface height>", 0 when unreadable.
fn sheetRegionPart(v: string, i: number): number = match v.split(",").at(i) { case some(x) => match parseNumber(x) { case some(n) => n, case none => 0 }, case none => 0 }

// Whether a detent is closed (`isNormalizedDetentClosed`): a point or
// percentage value of 0. The adapters refuse any other malformed value.
fn sheetDetentClosed(d: SheetDetent): bool = d.value != "content" && match d.value.split("%").at(0) { case some(x) => match parseNumber(x) { case some(n) => n == 0, case none => false }, case none => false }

fn sheetIndexClosed(detents: SheetDetent[], index: number): bool = match detents.at(index) { case some(d) => sheetDetentClosed(d), case none => false }

fn sheetIsLazy(config: SheetConfig): bool = match config.lazy { case some(b) => b, case none => false }

// Whether a sheet's content is mounted: always, unless `lazy`, then while
// `index` is open or the sheet hasn't yet come to rest closed.
fn sheetMounted(config: SheetConfig, detents: SheetDetent[], index: number, restingClosed: bool): bool = !sheetIsLazy(config) || !sheetIndexClosed(detents, index) || !restingClosed

// Whether the component draws a surface node (`${id}-surface`), which the tag
// adopts as React Native's `surface` element is mounted.
fn sheetHasSurface(config: SheetConfig): bool = (match config.surfaceColor { case some(c) => true, case none => false }) || (match config.surfaceBackgroundImage { case some(c) => true, case none => false })

fn sheetSurfaceColor(config: SheetConfig): string = match config.surfaceColor { case some(c) => c, case none => "transparent" }

fn sheetSurfaceImage(config: SheetConfig): string = match config.surfaceBackgroundImage { case some(c) => c, case none => "none" }

fn sheetUsesOverlay(config: SheetConfig): bool = (match config.modal { case some(b) => b, case none => false }) && (match config.nativeOverlay { case some(b) => b, case none => false })

// Whether an overlay sheet keeps VoiceOver to itself: while it is open or
// still closing (its scrim shown), as `BottomSheetComponentView.mm` sets
// `accessibilityViewIsModal` on its overlay from `isModalAccessibilityActive`.
// Exact maps `aria-modal` to that on iOS and to the attribute on the web.
fn sheetOverlayModal(config: SheetConfig, detents: SheetDetent[], index: number, restingClosed: bool): bool = sheetUsesOverlay(config) && (!sheetIndexClosed(detents, index) || !restingClosed)

// A modal sheet takes no touches once `index` is closed, so the page behind
// it is usable while it closes, as `BottomSheet.tsx`'s wrapper
// (`pointerEvents` 'none' when closed).
fn sheetPointerEvents(config: SheetConfig, detents: SheetDetent[], index: number): string = (match config.modal { case some(b) => b, case none => false }) && sheetIndexClosed(detents, index) ? "none" : "auto"

// A controlled sheet: `indexchange` is the sheet's own index changes (a drag,
// the scrim), `settle` the index it came to rest at, `closerequest` the web's
// Escape on a modal sheet with `handlesCloseRequest`. Bind an action that does
// nothing to an event you don't need. The handlers must be actions of the root
// component (Exact's rule for a package view's events).
component BottomSheet
  props
    id: string
    index: number
    detents: SheetDetent[]
    config: SheetConfig
    indexchange: action
    settle: action
    closerequest: action
  slot
  state regionWidth = 0
  state regionHeight = 0
  // The surface node's height (the sheet plus the overflow that keeps a
  // scaled card covered), from the tag.
  state surfaceHeight = 0
  // Whether the tag last reported resting at a closed detent; true before its
  // first report, so a lazy sheet created closed has no content.
  state restingClosed = true
  // Whether an overlay sheet's layer was put in the top layer.
  state lifted = false
  action sized(v: string)
    regionWidth = sheetRegionPart(v, 0) > 0 ? sheetRegionPart(v, 0) : regionWidth
    regionHeight = sheetRegionPart(v, 1) > 0 ? sheetRegionPart(v, 1) : regionHeight
    surfaceHeight = sheetRegionPart(v, 3) > 0 ? sheetRegionPart(v, 3) : surfaceHeight
    // An overlay sheet is lifted on the tag's first report, and again each
    // time it opens from rest, which brings it in front of the others (as
    // `BottomSheetComponentView.mm`'s `bringOverlayToFront`).
    if sheetUsesOverlay(config) && (!lifted || (restingClosed && sheetRegionPart(v, 2) == 0))
      hidePopover(`${id}-layer`)
      showPopover(`${id}-layer`)
      lifted = true
    restingClosed = sheetRegionPart(v, 2) == 1
  view
    column id=`${id}-layer` popover=(sheetUsesOverlay(config) ? some("manual") : none) aria-modal=sheetOverlayModal(config, detents, index, restingClosed) position="absolute" top=0 left=0 width="100%" height="100%" margin=0 padding=0 border-width=0 background-color="transparent" overflow="visible" pointer-events="none"
      if sheetMounted(config, detents, index, restingClosed) && sheetHasSurface(config)
        view testId=`${id}-surface` position="absolute" top=0 left=0 width=(regionWidth == 0 ? "100%" : `${regionWidth}px`) height=(surfaceHeight == 0 ? "100%" : `${surfaceHeight}px`) background-color=sheetSurfaceColor(config) background-image=sheetSurfaceImage(config) pointer-events="auto" opacity=(regionWidth == 0 ? 0 : 1)
      if sheetMounted(config, detents, index, restingClosed)
        column testId=`${id}-content` position="absolute" top=0 left=0 width=(regionWidth == 0 ? "100%" : `${regionWidth}px`) height=(regionHeight == 0 ? "auto" : `${regionHeight}px`) display="flex" flex-direction="column" pointer-events="auto" opacity=(regionWidth == 0 ? 0 : 1)
          children
          view testId=`${id}-end` height=0 flex-shrink=0
      swm-bottom-sheet testId=`${id}-sheet` contentId=`${id}-content` position="absolute" inset=0 pointer-events=sheetPointerEvents(config, detents, index) index=index detents=detents topInset=config.topInset modal=config.modal animateIn=config.animateIn animateContentHeight=config.animateContentHeight settleDuration=config.settleDuration scrollExpand=config.scrollExpand scrollCollapse=config.scrollCollapse scrimColor=config.scrimColor scrimLabel=config.scrimLabel surfaceId=(sheetHasSurface(config) ? some(`${id}-surface`) : none) surfaceCornerRadii=config.surfaceCornerRadii surfaceCornerCurve=config.surfaceCornerCurve surfaceShadows=config.surfaceShadows handlesCloseRequest=config.handlesCloseRequest nativeOverlay=some(sheetUsesOverlay(config)) change=sized indexchange=indexchange settle=settle closerequest=closerequest

// `BottomSheet` that also reports `positionchange` (every frame while the
// sheet moves, as `onPositionChange` fires), so it is bound only by those who
// ask for it. It sets the tag's `trackPosition`: without it the tag sends no
// position at all, since Exact can't tell a view which events are bound.
component TrackedBottomSheet
  props
    id: string
    index: number
    detents: SheetDetent[]
    config: SheetConfig
    indexchange: action
    settle: action
    closerequest: action
    positionchange: action
  slot
  state regionWidth = 0
  state regionHeight = 0
  // The surface node's height (the sheet plus the overflow that keeps a
  // scaled card covered), from the tag.
  state surfaceHeight = 0
  // Whether the tag last reported resting at a closed detent; true before its
  // first report, so a lazy sheet created closed has no content.
  state restingClosed = true
  // Whether an overlay sheet's layer was put in the top layer.
  state lifted = false
  action sized(v: string)
    regionWidth = sheetRegionPart(v, 0) > 0 ? sheetRegionPart(v, 0) : regionWidth
    regionHeight = sheetRegionPart(v, 1) > 0 ? sheetRegionPart(v, 1) : regionHeight
    surfaceHeight = sheetRegionPart(v, 3) > 0 ? sheetRegionPart(v, 3) : surfaceHeight
    // An overlay sheet is lifted on the tag's first report, and again each
    // time it opens from rest, which brings it in front of the others (as
    // `BottomSheetComponentView.mm`'s `bringOverlayToFront`).
    if sheetUsesOverlay(config) && (!lifted || (restingClosed && sheetRegionPart(v, 2) == 0))
      hidePopover(`${id}-layer`)
      showPopover(`${id}-layer`)
      lifted = true
    restingClosed = sheetRegionPart(v, 2) == 1
  view
    column id=`${id}-layer` popover=(sheetUsesOverlay(config) ? some("manual") : none) aria-modal=sheetOverlayModal(config, detents, index, restingClosed) position="absolute" top=0 left=0 width="100%" height="100%" margin=0 padding=0 border-width=0 background-color="transparent" overflow="visible" pointer-events="none"
      if sheetMounted(config, detents, index, restingClosed) && sheetHasSurface(config)
        view testId=`${id}-surface` position="absolute" top=0 left=0 width=(regionWidth == 0 ? "100%" : `${regionWidth}px`) height=(surfaceHeight == 0 ? "100%" : `${surfaceHeight}px`) background-color=sheetSurfaceColor(config) background-image=sheetSurfaceImage(config) pointer-events="auto" opacity=(regionWidth == 0 ? 0 : 1)
      if sheetMounted(config, detents, index, restingClosed)
        column testId=`${id}-content` position="absolute" top=0 left=0 width=(regionWidth == 0 ? "100%" : `${regionWidth}px`) height=(regionHeight == 0 ? "auto" : `${regionHeight}px`) display="flex" flex-direction="column" pointer-events="auto" opacity=(regionWidth == 0 ? 0 : 1)
          children
          view testId=`${id}-end` height=0 flex-shrink=0
      swm-bottom-sheet testId=`${id}-sheet` contentId=`${id}-content` position="absolute" inset=0 pointer-events=sheetPointerEvents(config, detents, index) index=index detents=detents topInset=config.topInset modal=config.modal animateIn=config.animateIn animateContentHeight=config.animateContentHeight settleDuration=config.settleDuration scrollExpand=config.scrollExpand scrollCollapse=config.scrollCollapse scrimColor=config.scrimColor scrimLabel=config.scrimLabel surfaceId=(sheetHasSurface(config) ? some(`${id}-surface`) : none) surfaceCornerRadii=config.surfaceCornerRadii surfaceCornerCurve=config.surfaceCornerCurve surfaceShadows=config.surfaceShadows handlesCloseRequest=config.handlesCloseRequest trackPosition=some(true) nativeOverlay=some(sheetUsesOverlay(config)) change=sized indexchange=indexchange settle=settle closerequest=closerequest positionchange=positionchange
