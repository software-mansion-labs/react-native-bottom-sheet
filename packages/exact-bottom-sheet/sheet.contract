// @swmansion/exact-bottom-sheet — the bottom sheet as a library component:
// `use BottomSheet, detent, sheetOptions from "@swmansion/exact-bottom-sheet/sheet"`.
// It is the counterpart of React Native's `BottomSheet` and
// `ModalBottomSheet`: a controlled `index` over `detents`, the content as its
// children, laid out at the sheet's content region (the widest card's width,
// the region's height), so `flex: 1` children fill it and a scrolling child
// scrolls within it. The sheet itself is the package's native view
// (`swm-bottom-sheet`, the shared iOS and web code); see README.md.
//
// Its look is its `surface` param, whose default is the package's token
// (exact-bottom-sheet.tamber); an app restyles every sheet by setting the
// param or the token by full name in its design, never by editing this file.
// What the native code draws (the card's corners and shadows, the scrim) is
// in `SheetOptions`, as plain values: a param can only reach Contract's own
// styles.

// The interface's shapes (exact.json), declared again: a package's Contract
// file is resolved where it really is, where no `node_modules` holds this
// package, and `use` takes only `.contract` files, so this file can't `use`
// them. Shapes are nominal in Contract, so an app takes these; the tag checks
// them field by field against its declared props, so the raw tag takes them
// too.
shape SheetInsets
  left: number
  right: number
  bottom: number

// A detent: a height the sheet rests at. Make one with `detent`,
// `programmaticDetent` or `insetDetent`.
shape SheetDetent
  value: string
  programmatic: option<bool>
  insets: option<SheetInsets>
  scrimOpacity: option<number>

shape SheetShadow
  offsetX: number
  offsetY: number
  blurRadius: number
  spreadDistance: number
  color: string
  opacity: number

// `positionchange`'s argument: points from the bottom, and the detent index as
// a fraction between the two the sheet is between.
shape SheetPosition
  position: number
  index: number

shape SheetRegion
  width: number
  height: number

// The sheet's options, React Native's props other than `index`, `detents` and
// `modal`. Start from `sheetOptions()`, React Native's defaults, and change
// fields with copy-with: `SheetOptions(sheetOptions(), lazy=true)`.
shape SheetOptions
  // The gap above the tallest detent, in points; -1 is below the status bar.
  topInset: number
  // Mount the content only while the sheet is open or still closing.
  lazy: bool
  // A modal sheet above everything, native modal routes included, sized to
  // the window wherever it is mounted.
  nativeOverlay: bool
  // Animate the first presentation.
  animateIn: bool
  // Animate the `content` detent following the content's height.
  animateContentHeight: bool
  // Seconds the spring takes to settle at a detent; 0 is the default (0.45).
  settleDuration: number
  // How a drag that starts in a scrolling child expands and collapses the
  // sheet (React Native's `scrollCoordination`).
  scrollExpand: enum<"handoff", "initial", "none">
  scrollCollapse: enum<"initial", "handoff", "none">
  // A modal sheet's scrim colour; "" is the platform's.
  scrimColor: string
  // What screen readers call the scrim's dismiss button; "" is "Dismiss".
  scrimLabel: string
  // This sheet's surface colour, any CSS colour (a role, `light-dark()`);
  // "" is the `surface` param, which is how an app should theme its sheets.
  surfaceColor: string
  // A CSS `background-image` over the surface colour (a gradient, `url(…)`);
  // "" for none.
  surfaceImage: string
  // The card's corner radii, top-left, top-right, bottom-right, bottom-left;
  // [] for square corners.
  cornerRadii: number[]
  cornerCurve: enum<"circular", "continuous">
  // The card's shadows, as `boxShadow` draws them; [] for none.
  shadows: SheetShadow[]
  // Send `closerequest` for Escape on a modal sheet (web only): Exact can't
  // tell a view which events are bound.
  handlesCloseRequest: bool
  // Send `positionchange` every frame the sheet moves, for the same reason.
  trackPosition: bool

// React Native's defaults.
fn sheetOptions(): SheetOptions = SheetOptions(topInset=-1, lazy=false, nativeOverlay=false, animateIn=true, animateContentHeight=true, settleDuration=0, scrollExpand="handoff", scrollCollapse="initial", scrimColor="", scrimLabel="", surfaceColor="", surfaceImage="", cornerRadii=[], cornerCurve="circular", shadows=[], handlesCloseRequest=false, trackPosition=false)

// A detent at `value`: points ("320"), a percentage of the space ("50%") or
// "content", the content's height. "0" closes the sheet.
fn detent(value: string): SheetDetent = SheetDetent(value=value, programmatic=none, insets=none, scrimOpacity=none)

// A detent a drag can't reach, only `index`.
fn programmaticDetent(value: string): SheetDetent = SheetDetent(value=value, programmatic=some(true), insets=none, scrimOpacity=none)

// A detached card: gaps around the card at this detent, in points.
fn insetDetent(value: string, left: number, right: number, bottom: number): SheetDetent = SheetDetent(value=value, programmatic=none, insets=some(SheetInsets(left=left, right=right, bottom=bottom)), scrimOpacity=none)

// A shadow for `shadows`.
fn surfaceShadow(offsetX: number, offsetY: number, blurRadius: number, spreadDistance: number, color: string, opacity: number): SheetShadow = SheetShadow(offsetX=offsetX, offsetY=offsetY, blurRadius=blurRadius, spreadDistance=spreadDistance, color=color, opacity=opacity)

// One number of the tag's `change` event, "<width>,<height>,<resting closed>,
// <surface height>", 0 when unreadable.
fn sheetRegionPart(v: string, i: number): number = match v.split(",").at(i) { case some(x) => match parseNumber(x) { case some(n) => n, case none => 0 }, case none => 0 }

// Whether a detent is closed (`isNormalizedDetentClosed`): a point or
// percentage value of 0. The adapters refuse any other malformed value.
fn sheetDetentClosed(d: SheetDetent): bool = d.value != "content" && match d.value.split("%").at(0) { case some(x) => match parseNumber(x) { case some(n) => n == 0, case none => false }, case none => false }

fn sheetIndexClosed(detents: SheetDetent[], index: number): bool = match detents.at(index) { case some(d) => sheetDetentClosed(d), case none => false }

// Whether the content is mounted: always, unless `lazy`, then while `index`
// is open or the sheet hasn't yet come to rest closed.
fn sheetMounted(options: SheetOptions, detents: SheetDetent[], index: number, restingClosed: bool): bool = !options.lazy || !sheetIndexClosed(detents, index) || !restingClosed

fn sheetUsesOverlay(modal: bool, options: SheetOptions): bool = modal && options.nativeOverlay

// Whether an overlay sheet keeps VoiceOver to itself: while it is open or
// still closing (its scrim shown), as `BottomSheetComponentView.mm` sets
// `accessibilityViewIsModal` on its overlay. Exact maps `aria-modal` to that
// on iOS and to the attribute on the web.
fn sheetOverlayModal(modal: bool, options: SheetOptions, detents: SheetDetent[], index: number, restingClosed: bool): bool = sheetUsesOverlay(modal, options) && (!sheetIndexClosed(detents, index) || !restingClosed)

// A modal sheet takes no touches once `index` is closed, so the page behind
// it is usable while it closes, as `BottomSheet.tsx`'s wrapper.
fn sheetPointerEvents(modal: bool, detents: SheetDetent[], index: number): string = modal && sheetIndexClosed(detents, index) ? "none" : "auto"

// The sheet. `indexchange` is the sheet's own index changes (a drag, the
// scrim; bind the action that sets `index`), `settle` the index it came to
// rest at, `positionchange` its position every frame it moves (with
// `trackPosition`), `closerequest` the web's Escape on a modal sheet (with
// `handlesCloseRequest`). Each is required, as a library component's actions
// are: bind an action that does nothing to one you don't need. The handlers
// must be actions of the root component (Exact's rule for a package view's
// events).
component BottomSheet
  params
    surface: color = "exact-bottom-sheet.surface" control = "token" group = "Color" priority = 1 label = "Surface"
  props
    // Names its testIds: `${id}-content`, `${id}-surface`, `${id}-sheet`,
    // `${id}-end`, `${id}-layer`.
    id: string
    // The detent the sheet is at or moving to; set it to move the sheet.
    index: number
    detents: SheetDetent[]
    // A modal sheet: a scrim behind it, the page under it not reachable.
    modal: bool
    options: SheetOptions
    indexchange: action
    settle: action
    positionchange: action
    closerequest: action
  slot
  parts
    surface: paint
    content: space
  state regionWidth = 0
  state regionHeight = 0
  // The surface's height (the sheet plus the overflow that keeps a scaled
  // card covered), from the tag.
  state surfaceHeight = 0
  // Whether the tag last reported resting at a closed detent; true before its
  // first report, so a lazy sheet created closed has no content.
  state restingClosed = true
  // Whether an overlay sheet's layer was put in the top layer.
  state lifted = false
  action sized(v: string)
    regionWidth = sheetRegionPart(v, 0) > 0 ? sheetRegionPart(v, 0) : regionWidth
    regionHeight = sheetRegionPart(v, 1) > 0 ? sheetRegionPart(v, 1) : regionHeight
    surfaceHeight = sheetRegionPart(v, 3) > 0 ? sheetRegionPart(v, 3) : surfaceHeight
    // An overlay sheet is lifted on the tag's first report, and again each
    // time it opens from rest, which brings it in front of the others (as
    // `BottomSheetComponentView.mm`'s `bringOverlayToFront`).
    if sheetUsesOverlay(modal, options) && (!lifted || (restingClosed && sheetRegionPart(v, 2) == 0))
      hidePopover(`${id}-layer`)
      showPopover(`${id}-layer`)
      lifted = true
    restingClosed = sheetRegionPart(v, 2) == 1
  view
    column id=`${id}-layer` popover=(sheetUsesOverlay(modal, options) ? some("manual") : none) aria-modal=sheetOverlayModal(modal, options, detents, index, restingClosed) position="absolute" top=0 left=0 width="100%" height="100%" margin=0 padding=0 border-width=0 background-color="transparent" overflow="visible" pointer-events="none"
      if sheetMounted(options, detents, index, restingClosed)
        view part="surface" testId=`${id}-surface` position="absolute" top=0 left=0 width=(regionWidth == 0 ? "100%" : `${regionWidth}px`) height=(surfaceHeight == 0 ? "100%" : `${surfaceHeight}px`) background-color=(options.surfaceColor == "" ? "param.surface" : options.surfaceColor) background-image=(options.surfaceImage == "" ? "none" : options.surfaceImage) pointer-events="auto" opacity=(regionWidth == 0 ? 0 : 1)
      if sheetMounted(options, detents, index, restingClosed)
        column part="content" testId=`${id}-content` position="absolute" top=0 left=0 width=(regionWidth == 0 ? "100%" : `${regionWidth}px`) height=(regionHeight == 0 ? "auto" : `${regionHeight}px`) display="flex" flex-direction="column" pointer-events="auto" opacity=(regionWidth == 0 ? 0 : 1)
          children
          view testId=`${id}-end` height=0 flex-shrink=0
      swm-bottom-sheet testId=`${id}-sheet` contentId=`${id}-content` surfaceId=some(`${id}-surface`) position="absolute" inset=0 pointer-events=sheetPointerEvents(modal, detents, index) index=index detents=detents topInset=(options.topInset < 0 ? none : some(options.topInset)) modal=some(modal) animateIn=some(options.animateIn) animateContentHeight=some(options.animateContentHeight) settleDuration=(options.settleDuration > 0 ? some(options.settleDuration) : none) scrollExpand=some(options.scrollExpand) scrollCollapse=some(options.scrollCollapse) scrimColor=(options.scrimColor == "" ? none : some(options.scrimColor)) scrimLabel=(options.scrimLabel == "" ? none : some(options.scrimLabel)) surfaceCornerRadii=some(options.cornerRadii) surfaceCornerCurve=some(options.cornerCurve) surfaceShadows=some(options.shadows) handlesCloseRequest=some(options.handlesCloseRequest) trackPosition=some(options.trackPosition) nativeOverlay=some(sheetUsesOverlay(modal, options)) change=sized indexchange=indexchange settle=settle closerequest=closerequest positionchange=positionchange
